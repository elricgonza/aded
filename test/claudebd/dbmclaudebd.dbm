<view name="v_rendimiento_estudiantes" layer="0" collapse-mode="1" max-obj-count="1">
	<schema name="public"/>
	<role name="postgres"/>
	<comment><![CDATA[Rendimiento académico de estudiantes]]></comment>
	<position x="280" y="1640"/>
	<reference>
		<expression><![CDATA[ SELECT i.id AS inscripcion_id,
    e.codigo_estudiante,
    (((e.nombres)::text || ' '::text) || (e.apellido_paterno)::text) AS estudiante,
    (((((g.nivel)::text || ' '::text) || (g.grado)::text) || ' '::text) || (c.paralelo)::text) AS curso,
    ges.anio AS gestion,
    count(DISTINCT s.materia_id) AS total_materias,
    count(
        CASE
            WHEN (s.aprobado = true) THEN 1
            ELSE NULL::integer
        END) AS materias_aprobadas,
    count(
        CASE
            WHEN (s.aprobado = false) THEN 1
            ELSE NULL::integer
        END) AS materias_reprobadas,
    round(avg(s.promedio_bimestre), 2) AS promedio_general,
        CASE
            WHEN (count(
            CASE
                WHEN (s.aprobado = false) THEN 1
                ELSE NULL::integer
            END) = 0) THEN 'Aprobado'::text
            ELSE 'Reprobado'::text
        END AS estado_final
   FROM (((((inscripcion i
     JOIN estudiante e ON ((i.estudiante_id = e.id)))
     JOIN curso c ON ((i.curso_id = c.id)))
     JOIN grado g ON ((c.grado_id = g.id)))
     JOIN gestion ges ON ((i.gestion_id = ges.id)))
     LEFT JOIN seguimiento s ON ((i.id = s.inscripcion_id)))
  WHERE ((i.estado)::text = 'Activo'::text)
  GROUP BY i.id, e.codigo_estudiante, e.nombres, e.apellido_paterno, g.nivel, g.grado, c.paralelo, ges.anio;]]></expression>
	<column name="inscripcion_id">
		<type name="integer" length="0"/>
	</column>
	<column name="codigo_estudiante">
		<type name="character varying" length="20"/>
	</column>
	<column name="estudiante">
		<type name="text" length="0"/>
	</column>
	<column name="curso">
		<type name="text" length="0"/>
	</column>
	<column name="gestion">
		<type name="smallint" length="0"/>
	</column>
	<column name="total_materias">
		<type name="bigint" length="0"/>
	</column>
	<column name="materias_aprobadas">
		<type name="bigint" length="0"/>
	</column>
	<column name="materias_reprobadas">
		<type name="bigint" length="0"/>
	</column>
	<column name="promedio_general">
		<type name="numeric" length="0"/>
	</column>
	<column name="estado_final">
		<type name="text" length="0"/>
	</column>
		<reftable name="public.gestion"/>
		<reftable name="public.grado"/>
		<reftable name="public.estudiante"/>
		<reftable name="public.curso"/>
		<reftable name="public.inscripcion"/>
		<reftable name="public.seguimiento"/>
	</reference>
</view>

