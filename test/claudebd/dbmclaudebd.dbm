<view name="v_pagos_estudiante" layer="0" collapse-mode="1" max-obj-count="1">
	<schema name="public"/>
	<role name="postgres"/>
	<comment><![CDATA[Estado de pagos por estudiante]]></comment>
	<position x="1040" y="1640"/>
	<reference>
		<expression><![CDATA[ SELECT e.codigo_estudiante,
    (((e.nombres)::text || ' '::text) || (e.apellido_paterno)::text) AS estudiante,
    (((((g.nivel)::text || ' '::text) || (g.grado)::text) || ' '::text) || (c.paralelo)::text) AS curso,
    cp.nombre AS concepto,
    p.monto,
    p.descuento,
    p.monto_total,
    p.fecha_vencimiento,
    p.fecha_pago,
    p.mes_correspondiente,
    p.estado,
        CASE
            WHEN ((p.estado)::text = 'Vencido'::text) THEN (p.fecha_vencimiento - CURRENT_DATE)
            ELSE 0
        END AS dias_vencidos
   FROM (((((inscripcion i
     JOIN estudiante e ON ((i.estudiante_id = e.id)))
     JOIN curso c ON ((i.curso_id = c.id)))
     JOIN grado g ON ((c.grado_id = g.id)))
     JOIN pago p ON ((i.id = p.inscripcion_id)))
     JOIN concepto_pago cp ON ((p.concepto_pago_id = cp.id)))
  WHERE ((i.estado)::text = 'Activo'::text);]]></expression>
	<column name="codigo_estudiante">
		<type name="character varying" length="20"/>
	</column>
	<column name="estudiante">
		<type name="text" length="0"/>
	</column>
	<column name="curso">
		<type name="text" length="0"/>
	</column>
	<column name="concepto">
		<type name="character varying" length="100"/>
	</column>
	<column name="monto">
		<type name="numeric" length="10" precision="2"/>
	</column>
	<column name="descuento">
		<type name="numeric" length="10" precision="2"/>
	</column>
	<column name="monto_total">
		<type name="numeric" length="10" precision="2"/>
	</column>
	<column name="fecha_vencimiento">
		<type name="date" length="0"/>
	</column>
	<column name="fecha_pago">
		<type name="date" length="0"/>
	</column>
	<column name="mes_correspondiente">
		<type name="smallint" length="0"/>
	</column>
	<column name="estado">
		<type name="character varying" length="20"/>
	</column>
	<column name="dias_vencidos">
		<type name="integer" length="0"/>
	</column>
		<reftable name="public.grado"/>
		<reftable name="public.estudiante"/>
		<reftable name="public.curso"/>
		<reftable name="public.inscripcion"/>
		<reftable name="public.concepto_pago"/>
		<reftable name="public.pago"/>
	</reference>
</view>

