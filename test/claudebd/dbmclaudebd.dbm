</trigger>

<function name="calcular_promedio_seguimiento"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql" sql-disabled="true"/>
	<return-type>
	<type name="trigger" length="1"/>
	</return-type>
	<definition><![CDATA[
BEGIN
    -- Calcular promedio del bimestre
    NEW.promedio_bimestre = (
        COALESCE(NEW.evaluacion_1, 0) + 
        COALESCE(NEW.evaluacion_2, 0) + 
        COALESCE(NEW.evaluacion_3, 0)
    ) / 3.0;
    
    -- Determinar si aprobó (nota >= 51)
    NEW.aprobado = (NEW.promedio_bimestre >= 51);
    
    RETURN NEW;
END;
]]></definition>
</function>

<trigger name="trg_seguimiento_calcular_promedio" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="true" del-event="false" upd-event="true" trunc-event="false"
	 table="public.seguimiento">
		<function signature="public.calcular_promedio_seguimiento()"/>
</trigger>

<function name="calcular_monto_total_pago"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql" sql-disabled="true"/>
	<return-type>
	<type name="trigger" length="1"/>
	</return-type>
	<definition><![CDATA[
BEGIN
    NEW.monto_total = NEW.monto - COALESCE(NEW.descuento, 0);
    RETURN NEW;
END;
]]></definition>
</function>

<trigger name="trg_pago_calcular_total" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="true" del-event="false" upd-event="true" trunc-event="false"
	 table="public.pago">
		<function signature="public.calcular_monto_total_pago()"/>
</trigger>

<view name="v_estudiantes_inscritos" layer="0" collapse-mode="1" max-obj-count="1">
	<schema name="public"/>
	<role name="postgres"/>
	<comment><![CDATA[Vista completa de estudiantes inscritos con información de tutor y curso]]></comment>
	<position x="1080" y="1100"/>
	<reference>
		<expression><![CDATA[ SELECT e.id AS estudiante_id,
    e.codigo_estudiante,
    (((((e.nombres)::text || ' '::text) || (e.apellido_paterno)::text) || ' '::text) || (COALESCE(e.apellido_materno, ''::character varying))::text) AS nombre_completo,
    e.ci,
    e.genero,
    e.fecha_nacimiento,
    date_part('year'::text, age((e.fecha_nacimiento)::timestamp with time zone)) AS edad,
    (((t.nombres)::text || ' '::text) || (t.apellido_paterno)::text) AS tutor,
    t.telefono AS telefono_tutor,
    i.id AS inscripcion_id,
    c.id AS curso_id,
    g.nivel,
    g.grado,
    c.paralelo,
    ges.anio AS gestion,
    i.estado AS estado_inscripcion,
    (((p.nombres)::text || ' '::text) || (p.apellido_paterno)::text) AS profesor_tutor
   FROM ((((((estudiante e
     LEFT JOIN tutor t ON ((e.tutor_id = t.id)))
     LEFT JOIN inscripcion i ON (((e.id = i.estudiante_id) AND ((i.estado)::text = 'Activo'::text))))
     LEFT JOIN curso c ON ((i.curso_id = c.id)))
     LEFT JOIN grado g ON ((c.grado_id = g.id)))
     LEFT JOIN gestion ges ON ((i.gestion_id = ges.id)))
     LEFT JOIN profesor p ON ((c.profesor_tutor_id = p.id)))
  WHERE (e.activo = true);]]></expression>
	<column name="estudiante_id">
		<type name="integer" length="0"/>
	</column>
	<column name="codigo_estudiante">
		<type name="character varying" length="20"/>
	</column>
	<column name="nombre_completo">
		<type name="text" length="0"/>
	</column>
	<column name="ci">
		<type name="character varying" length="20"/>
	</column>
	<column name="genero">
		<type name="character" length="1"/>
	</column>
	<column name="fecha_nacimiento">
		<type name="date" length="0"/>
	</column>
	<column name="edad">
		<type name="double precision" length="0"/>
	</column>
	<column name="tutor">
		<type name="text" length="0"/>
	</column>
	<column name="telefono_tutor">
		<type name="character varying" length="20"/>
	</column>
	<column name="inscripcion_id">
		<type name="integer" length="0"/>
	</column>
	<column name="curso_id">
		<type name="integer" length="0"/>
	</column>
	<column name="nivel">
		<type name="character varying" length="50"/>
	</column>
	<column name="grado">
		<type name="character varying" length="50"/>
	</column>
	<column name="paralelo">
		<type name="character varying" length="50"/>
	</column>
	<column name="gestion">
		<type name="smallint" length="0"/>
	</column>
	<column name="estado_inscripcion">
		<type name="character varying" length="20"/>
	</column>
	<column name="profesor_tutor">
		<type name="text" length="0"/>
	</column>
		<reftable name="public.gestion"/>
		<reftable name="public.grado"/>
		<reftable name="public.tutor"/>
		<reftable name="public.estudiante"/>
		<reftable name="public.profesor"/>
		<reftable name="public.curso"/>
		<reftable name="public.inscripcion"/>
	</reference>
</view>

