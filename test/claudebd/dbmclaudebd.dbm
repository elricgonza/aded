<table name="gestion" layer="0" collapse-mode="1" max-obj-count="8">
	<schema name="public"/>
	<role name="postgres"/>
	<comment><![CDATA[Períodos escolares (años y semestres)]]></comment>
	<position x="80" y="40"/>
	<column name="id" not-null="true" sequence="public.gestion_id_seq">
		<type name="integer" length="0"/>
	</column>
	<column name="anio" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="periodo" not-null="true">
		<type name="character varying" length="50"/>
	</column>
	<column name="fecha_inicio" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="fecha_fin" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="activo" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<column name="created_at" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
	</column>
	<constraint name="gestion_fechas_ck" type="ck-constr" table="public.gestion">
			<expression><![CDATA[(fecha_fin > fecha_inicio)]]></expression>
	</constraint>
	<constraint name="gestion_pkey" type="pk-constr" table="public.gestion">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="gestion_uq" type="uq-constr" table="public.gestion">
		<columns names="anio,periodo" ref-type="src-columns"/>
	</constraint>
</table>

