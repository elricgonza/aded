<view name="v_resumen_financiero" layer="0" collapse-mode="1" max-obj-count="1">
	<schema name="public"/>
	<role name="postgres"/>
	<comment><![CDATA[Resumen financiero por gestión y concepto]]></comment>
	<position x="800" y="1900"/>
	<reference>
		<expression><![CDATA[ SELECT ges.anio AS gestion,
    cp.nombre AS concepto,
    count(DISTINCT p.inscripcion_id) AS total_estudiantes,
    count(*) AS total_registros,
    count(
        CASE
            WHEN ((p.estado)::text = 'Pagado'::text) THEN 1
            ELSE NULL::integer
        END) AS pagados,
    count(
        CASE
            WHEN ((p.estado)::text = 'Pendiente'::text) THEN 1
            ELSE NULL::integer
        END) AS pendientes,
    count(
        CASE
            WHEN ((p.estado)::text = 'Vencido'::text) THEN 1
            ELSE NULL::integer
        END) AS vencidos,
    sum(
        CASE
            WHEN ((p.estado)::text = 'Pagado'::text) THEN p.monto_total
            ELSE (0)::numeric
        END) AS monto_recaudado,
    sum(
        CASE
            WHEN ((p.estado)::text = ANY ((ARRAY['Pendiente'::character varying, 'Vencido'::character varying])::text[])) THEN p.monto_total
            ELSE (0)::numeric
        END) AS monto_pendiente,
    sum(p.monto_total) AS monto_total
   FROM (((pago p
     JOIN inscripcion i ON ((p.inscripcion_id = i.id)))
     JOIN gestion ges ON ((i.gestion_id = ges.id)))
     JOIN concepto_pago cp ON ((p.concepto_pago_id = cp.id)))
  GROUP BY ges.anio, cp.nombre;]]></expression>
	<column name="gestion">
		<type name="smallint" length="0"/>
	</column>
	<column name="concepto">
		<type name="character varying" length="100"/>
	</column>
	<column name="total_estudiantes">
		<type name="bigint" length="0"/>
	</column>
	<column name="total_registros">
		<type name="bigint" length="0"/>
	</column>
	<column name="pagados">
		<type name="bigint" length="0"/>
	</column>
	<column name="pendientes">
		<type name="bigint" length="0"/>
	</column>
	<column name="vencidos">
		<type name="bigint" length="0"/>
	</column>
	<column name="monto_recaudado">
		<type name="numeric" length="0"/>
	</column>
	<column name="monto_pendiente">
		<type name="numeric" length="0"/>
	</column>
	<column name="monto_total">
		<type name="numeric" length="0"/>
	</column>
		<reftable name="public.gestion"/>
		<reftable name="public.inscripcion"/>
		<reftable name="public.concepto_pago"/>
		<reftable name="public.pago"/>
	</reference>
</view>

