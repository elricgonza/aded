<view name="v_asistencia_estudiantes" layer="0" collapse-mode="1" max-obj-count="1">
	<schema name="public"/>
	<role name="postgres"/>
	<comment><![CDATA[Estadísticas de asistencia por estudiante]]></comment>
	<position x="560" y="1640"/>
	<reference>
		<expression><![CDATA[ SELECT e.codigo_estudiante,
    (((e.nombres)::text || ' '::text) || (e.apellido_paterno)::text) AS estudiante,
    (((((g.nivel)::text || ' '::text) || (g.grado)::text) || ' '::text) || (c.paralelo)::text) AS curso,
    count(*) AS total_registros,
    count(
        CASE
            WHEN ((a.estado)::text = 'Presente'::text) THEN 1
            ELSE NULL::integer
        END) AS presentes,
    count(
        CASE
            WHEN ((a.estado)::text = 'Ausente'::text) THEN 1
            ELSE NULL::integer
        END) AS ausentes,
    count(
        CASE
            WHEN ((a.estado)::text = 'Tardanza'::text) THEN 1
            ELSE NULL::integer
        END) AS tardanzas,
    count(
        CASE
            WHEN ((a.estado)::text = 'Justificado'::text) THEN 1
            ELSE NULL::integer
        END) AS justificados,
    round((((count(
        CASE
            WHEN ((a.estado)::text = 'Presente'::text) THEN 1
            ELSE NULL::integer
        END))::numeric * 100.0) / (NULLIF(count(*), 0))::numeric), 2) AS porcentaje_asistencia
   FROM ((((inscripcion i
     JOIN estudiante e ON ((i.estudiante_id = e.id)))
     JOIN curso c ON ((i.curso_id = c.id)))
     JOIN grado g ON ((c.grado_id = g.id)))
     LEFT JOIN asistencia a ON ((i.id = a.inscripcion_id)))
  WHERE ((i.estado)::text = 'Activo'::text)
  GROUP BY e.codigo_estudiante, e.nombres, e.apellido_paterno, g.nivel, g.grado, c.paralelo;]]></expression>
	<column name="codigo_estudiante">
		<type name="character varying" length="20"/>
	</column>
	<column name="estudiante">
		<type name="text" length="0"/>
	</column>
	<column name="curso">
		<type name="text" length="0"/>
	</column>
	<column name="total_registros">
		<type name="bigint" length="0"/>
	</column>
	<column name="presentes">
		<type name="bigint" length="0"/>
	</column>
	<column name="ausentes">
		<type name="bigint" length="0"/>
	</column>
	<column name="tardanzas">
		<type name="bigint" length="0"/>
	</column>
	<column name="justificados">
		<type name="bigint" length="0"/>
	</column>
	<column name="porcentaje_asistencia">
		<type name="numeric" length="0"/>
	</column>
		<reftable name="public.grado"/>
		<reftable name="public.estudiante"/>
		<reftable name="public.curso"/>
		<reftable name="public.inscripcion"/>
		<reftable name="public.asistencia"/>
	</reference>
</view>

