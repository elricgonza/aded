<view name="v_horarios_curso" layer="0" collapse-mode="1" max-obj-count="1">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="820" y="1640"/>
	<reference>
		<expression><![CDATA[ SELECT c.id AS curso_id,
    (((((g.nivel)::text || ' '::text) || (g.grado)::text) || ' '::text) || (c.paralelo)::text) AS curso,
    c.turno,
        CASE h.dia_semana
            WHEN 1 THEN 'Lunes'::text
            WHEN 2 THEN 'Martes'::text
            WHEN 3 THEN 'Miércoles'::text
            WHEN 4 THEN 'Jueves'::text
            WHEN 5 THEN 'Viernes'::text
            WHEN 6 THEN 'Sábado'::text
            WHEN 7 THEN 'Domingo'::text
            ELSE NULL::text
        END AS dia,
    h.hora_inicio,
    h.hora_fin,
    m.nombre AS materia,
    (((p.nombres)::text || ' '::text) || (p.apellido_paterno)::text) AS profesor,
    h.aula
   FROM (((((curso c
     JOIN grado g ON ((c.grado_id = g.id)))
     JOIN asignacion a ON ((c.id = a.curso_id)))
     JOIN materia m ON ((a.materia_id = m.id)))
     JOIN profesor p ON ((a.profesor_id = p.id)))
     LEFT JOIN horario h ON ((a.id = h.asignacion_id)))
  WHERE (h.activo = true)
  ORDER BY c.id, h.dia_semana, h.hora_inicio;]]></expression>
	<column name="curso_id">
		<type name="integer" length="0"/>
	</column>
	<column name="curso">
		<type name="text" length="0"/>
	</column>
	<column name="turno">
		<type name="character varying" length="20"/>
	</column>
	<column name="dia">
		<type name="text" length="0"/>
	</column>
	<column name="hora_inicio">
		<type name="time" length="0"/>
	</column>
	<column name="hora_fin">
		<type name="time" length="0"/>
	</column>
	<column name="materia">
		<type name="character varying" length="150"/>
	</column>
	<column name="profesor">
		<type name="text" length="0"/>
	</column>
	<column name="aula">
		<type name="character varying" length="50"/>
	</column>
		<reftable name="public.grado"/>
		<reftable name="public.materia"/>
		<reftable name="public.profesor"/>
		<reftable name="public.curso"/>
		<reftable name="public.asignacion"/>
		<reftable name="public.horario"/>
	</reference>
</view>

