<dbmodel pgmodeler-ver="0.9.2" last-position="0,0" last-zoom="1" max-obj-count="6"
	 default-schema="public" default-owner="postgres">
<role name="appgeo"
      inherit="true"
      login="true"
      encrypted="true"
      password="********">
</role>

<role name="flask_user"
      inherit="true"
      login="true"
      encrypted="true"
      password="********">
</role>

<role name="uaded"
      inherit="true"
      login="true"
      encrypted="true"
      password="********">
</role>

<database name="authtest" encoding="UTF8" lc-collate="en_US.UTF-8" lc-ctype="en_US.UTF-8" is-template="false" allow-conns="true">
	<role name="postgres"/>
	<tablespace name="pg_default"/>
</database>

<schema name="public" layer="0" rect-visible="true" fill-color="#e1e1e1" sql-disabled="true">
</schema>

<sequence name="usr_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<table name="usr" layer="0" collapse-mode="1" max-obj-count="9">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="80" y="60"/>
	<column name="id" not-null="true" sequence="public.usr_id_seq">
		<type name="integer" length="0"/>
	</column>
	<column name="usuario" not-null="true">
		<type name="character varying" length="80"/>
	</column>
	<column name="email" not-null="true">
		<type name="character varying" length="120"/>
	</column>
	<column name="password" not-null="true">
		<type name="character varying" length="255"/>
	</column>
	<column name="activo">
		<type name="boolean" length="0"/>
	</column>
	<column name="ultimo_ingreso" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="creado">
		<type name="timestamp" length="0"/>
	</column>
	<column name="act">
		<type name="timestamp" length="0"/>
	</column>
	<constraint name="usr_pkey" type="pk-constr" table="public.usr">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<index name="ix_usr_usuario" table="public.usr"
	 concurrent="false" unique="true" fast-update="false" buffering="false"
	 index-type="btree" factor="90">
		<idxelement use-sorting="false">
			<column name="usuario"/>
		</idxelement>
</index>

<sequence name="rol_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<table name="rol" layer="0" collapse-mode="1" max-obj-count="6">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="500" y="60"/>
	<column name="id" not-null="true" sequence="public.rol_id_seq">
		<type name="integer" length="0"/>
	</column>
	<column name="rol" not-null="true">
		<type name="character varying" length="50"/>
	</column>
	<column name="descripcion">
		<type name="character varying" length="255"/>
	</column>
	<column name="creado">
		<type name="timestamp" length="0"/>
	</column>
	<column name="act">
		<type name="date" length="0"/>
	</column>
	<constraint name="rol_pkey" type="pk-constr" table="public.rol">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="rol_rol_key" type="uq-constr" table="public.rol">
		<columns names="rol" ref-type="src-columns"/>
	</constraint>
</table>

<sequence name="per_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<table name="per" layer="0" collapse-mode="1" max-obj-count="6">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="280" y="300"/>
	<column name="id" not-null="true" sequence="public.per_id_seq">
		<type name="integer" length="0"/>
	</column>
	<column name="permiso" not-null="true">
		<type name="character varying" length="50"/>
	</column>
	<column name="descripcion">
		<type name="character varying" length="255"/>
	</column>
	<column name="creado">
		<type name="timestamp" length="0"/>
	</column>
	<column name="act">
		<type name="timestamp" length="0"/>
	</column>
	<constraint name="per_pkey" type="pk-constr" table="public.per">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="per_permiso_key" type="uq-constr" table="public.per">
		<columns names="permiso" ref-type="src-columns"/>
	</constraint>
</table>

<table name="usr_rol" layer="0" collapse-mode="1" max-obj-count="3">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="260" y="40"/>
	<column name="usr_id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="rol_id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<constraint name="usr_rol_pkey" type="pk-constr" table="public.usr_rol">
		<columns names="usr_id,rol_id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="rol_per" layer="0" collapse-mode="1" max-obj-count="3">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="500" y="300"/>
	<column name="rol_id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="per_id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<constraint name="rol_per_pkey" type="pk-constr" table="public.rol_per">
		<columns names="rol_id,per_id" ref-type="src-columns"/>
	</constraint>
</table>

<constraint name="usr_rol_usr_id_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="NO ACTION" ref-table="public.usr" table="public.usr_rol">
	<columns names="usr_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="usr_rol_rol_id_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="NO ACTION" ref-table="public.rol" table="public.usr_rol">
	<columns names="rol_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="rol_per_rol_id_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="NO ACTION" ref-table="public.rol" table="public.rol_per">
	<columns names="rol_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="rol_per_per_id_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="NO ACTION" ref-table="public.per" table="public.rol_per">
	<columns names="per_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<relationship name="rel_usr_rol_usr" type="relfk" layer="0"
	 custom-color="#64fa03"
	 src-table="public.usr_rol"
	 dst-table="public.usr" reference-fk="usr_rol_usr_id_fkey"
	 src-required="false" dst-required="false">
	<label ref-type="name-label">
		<position x="48.7934" y="8.74505"/>
	</label>
</relationship>

<relationship name="rel_usr_rol_rol" type="relfk" layer="0"
	 custom-color="#448018"
	 src-table="public.usr_rol"
	 dst-table="public.rol" reference-fk="usr_rol_rol_id_fkey"
	 src-required="false" dst-required="false"/>

<relationship name="rel_rol_per_rol" type="relfk" layer="0"
	 custom-color="#48cc6f"
	 src-table="public.rol_per"
	 dst-table="public.rol" reference-fk="rol_per_rol_id_fkey"
	 src-required="false" dst-required="false"/>

<relationship name="rel_rol_per_per" type="relfk" layer="0"
