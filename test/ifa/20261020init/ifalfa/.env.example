# Copie este archivo a .env y complete los valores
FLASK_APP=wsgi.py
SECRET_KEY=CAMBIAR_generar_con__python3 -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql+psycopg://uaded:SU_CLAVE@localhost:5432/dbaded
# Parámetros del negocio
CUOTA_BASE=500.00
NUM_CUOTAS=1
NOTA_APROBACION=51
PER_PAGE=15
# Poner en 1 solo si se sirve por HTTPS (recomendado en producción)
SESSION_COOKIE_SECURE=0
TRUST_PROXY=0   # poner 1 si se sirve detrás de Nginx (para IP real y HTTPS)
