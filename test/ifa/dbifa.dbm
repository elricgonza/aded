<sequence name="audit_log_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<table name="audit_log" layer="0" collapse-mode="2" max-obj-count="14">
	<schema name="public"/>
	<role name="uaded"/>
	<comment><![CDATA[Registro de auditoría de acciones del sistema]]></comment>
	<position x="700" y="1080"/>
	<column name="id" not-null="true" sequence="public.audit_log_id_seq">
		<type name="integer" length="0"/>
	</column>
	<column name="usu_id">
		<type name="integer" length="0"/>
	</column>
	<column name="usuario" not-null="true" default-value="'anónimo'">
		<type name="character varying" length="80"/>
	</column>
	<column name="accion" not-null="true">
		<type name="character varying" length="20"/>
		<comment><![CDATA[Tipo de acción: CREATE, UPDATE, DELETE, LOGIN, LOGOUT, BULK, ERROR]]></comment>
	</column>
	<column name="modulo" not-null="true">
		<type name="character varying" length="50"/>
		<comment><![CDATA[Módulo del sistema: grado, materia, alumno, pago, etc.]]></comment>
	</column>
	<column name="entidad_id">
		<type name="integer" length="0"/>
	</column>
	<column name="detalle">
		<type name="text" length="0"/>
		<comment><![CDATA[JSON con detalles relevantes de la acción]]></comment>
	</column>
	<column name="ip">
		<type name="character varying" length="45"/>
	</column>
	<column name="endpoint">
		<type name="character varying" length="150"/>
	</column>
	<column name="metodo">
		<type name="character varying" length="10"/>
	</column>
	<column name="status" default-value="200">
		<type name="smallint" length="0"/>
	</column>
	<column name="creado" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
	</column>
	<constraint name="audit_log_accion_check" type="ck-constr" table="public.audit_log">
			<expression><![CDATA[((accion)::text = ANY ((ARRAY['CREATE'::character varying, 'UPDATE'::character varying, 'DELETE'::character varying, 'LOGIN'::character varying, 'LOGOUT'::character varying, 'BULK'::character varying, 'ERROR'::character varying])::text[]))]]></expression>
	</constraint>
	<constraint name="audit_log_pkey" type="pk-constr" table="public.audit_log">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

