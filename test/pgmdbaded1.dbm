<dbmodel pgmodeler-ver="0.9.2" last-position="0,0" last-zoom="1" max-obj-count="4"
	 default-schema="public" default-owner="postgres">
<role name="appgeo"
      inherit="true"
      login="true"
      encrypted="true"
      password="********">
</role>

<role name="flask_user"
      inherit="true"
      login="true"
      encrypted="true"
      password="********">
</role>

<role name="uaded"
      inherit="true"
      login="true"
      encrypted="true"
      password="********">
</role>

<database name="dbaded1" encoding="UTF8" lc-collate="en_US.UTF-8" lc-ctype="en_US.UTF-8" is-template="false" allow-conns="true">
	<role name="uaded"/>
	<tablespace name="pg_default"/>
</database>

<schema name="public" layer="0" rect-visible="true" fill-color="#e1e1e1" sql-disabled="true">
</schema>

<table name="plan" layer="0" collapse-mode="2" max-obj-count="2">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="160" y="80"/>
	<column name="id" not-null="true"
	 identity-type="BY DEFAULT" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
		<type name="integer" length="0"/>
	</column>
	<column name="plan" not-null="true">
		<type name="character varying" length="150"/>
	</column>
	<constraint name="plan_pkey" type="pk-constr" table="public.plan">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<sequence name="plan_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1" sql-disabled="true">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<table name="nivel" layer="0" collapse-mode="2" max-obj-count="3">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="420" y="220"/>
	<column name="id" not-null="true"
	 identity-type="BY DEFAULT" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
		<type name="integer" length="0"/>
	</column>
	<column name="nivel" not-null="true">
		<type name="character varying" length="255"/>
	</column>
	<column name="id_plan" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<constraint name="nivel_pkey" type="pk-constr" table="public.nivel">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<sequence name="nivel_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1" sql-disabled="true">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<table name="grado" layer="0" collapse-mode="2" max-obj-count="3">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="760" y="60"/>
	<column name="id" not-null="true"
	 identity-type="BY DEFAULT" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
		<type name="integer" length="0"/>
	</column>
	<column name="grado" not-null="true">
		<type name="character varying" length="255"/>
	</column>
	<column name="id_nivel" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<constraint name="grado_pkey" type="pk-constr" table="public.grado">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<sequence name="grado_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1" sql-disabled="true">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<table name="materia" layer="0" collapse-mode="2" max-obj-count="3">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="1100" y="100"/>
	<column name="id" not-null="true"
	 identity-type="BY DEFAULT" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
		<type name="integer" length="0"/>
	</column>
	<column name="materia" not-null="true">
		<type name="character varying" length="150"/>
	</column>
	<column name="id_grado" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<constraint name="materia_pkey" type="pk-constr" table="public.materia">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<sequence name="materia_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1" sql-disabled="true">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<constraint name="nivel_id_plan_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.plan" table="public.nivel">
	<columns names="id_plan" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="grado_id_nivel_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.nivel" table="public.grado">
	<columns names="id_nivel" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="materia_id_grado_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.grado" table="public.materia">
	<columns names="id_grado" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<relationship name="rel_nivel_plan" type="relfk" layer="0"
	 custom-color="#723acf"
	 src-table="public.nivel"
	 dst-table="public.plan" reference-fk="nivel_id_plan_fkey"
	 src-required="false" dst-required="false"/>

<relationship name="rel_grado_nivel" type="relfk" layer="0"
	 custom-color="#cc0000"
	 src-table="public.grado"
	 dst-table="public.nivel" reference-fk="grado_id_nivel_fkey"
	 src-required="false" dst-required="false"/>

<relationship name="rel_materia_grado" type="relfk" layer="0"
	 custom-color="#f911f7"
	 src-table="public.materia"
	 dst-table="public.grado" reference-fk="materia_id_grado_fkey"
	 src-required="false" dst-required="false"/>

</dbmodel>
