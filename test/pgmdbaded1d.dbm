</table>

<sequence name="curso_id_seq" cycle="false" start="1" increment="1" min-value="1" max-value="2147483647" cache="1" sql-disabled="true">
	<schema name="public"/>
	<role name="uaded"/>
</sequence>

<table name="seg" layer="0" collapse-mode="2" max-obj-count="3">
	<schema name="public"/>
	<role name="uaded"/>
	<comment><![CDATA[SEGuimiento académico]]></comment>
	<position x="1100" y="580"/>
	<column name="id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="id_alum">
		<type name="integer" length="0"/>
	</column>
	<constraint name="seg_pk" type="pk-constr" table="public.seg">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="prof" layer="0" collapse-mode="2" max-obj-count="3">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="1780" y="20"/>
	<column name="id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="nom_prof">
		<type name="varchar" length="100"/>
	</column>
	<column name="formacion">
		<type name="varchar" length="100"/>
	</column>
	<constraint name="prof_pk" type="pk-constr" table="public.prof">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="trab" layer="0" collapse-mode="2" max-obj-count="4">
	<schema name="public"/>
	<role name="uaded"/>
	<comment><![CDATA[prof trab (enseña) a un curso y descripción de materias asignadas]]></comment>
	<position x="1700" y="240"/>
	<column name="id" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<constraint name="trab_pk" type="pk-constr" table="public.trab">
		<columns names="id" ref-type="src-columns"/>
	</constraint>

	<customidxs object-type="column">
		<object name="id_curso" index="3"/>
		<object name="id_mat" index="2"/>
		<object name="id_prof" index="1"/>
	</customidxs>

	<customidxs object-type="constraint">
		<object name="curso_fk" index="3"/>
		<object name="mat_fk" index="1"/>
		<object name="prof_fk" index="0"/>
	</customidxs>
</table>

<relationship name="prof_has_many_trab" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#5184cc"
	 src-table="public.prof"
	 dst-table="public.trab"
	 src-required="false" dst-required="false"/>

<relationship name="mat_has_many_trab" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#34fc23"
	 src-table="public.mat"
	 dst-table="public.trab"
	 src-required="false" dst-required="false"/>

<relationship name="curso_has_many_trab" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#f77242"
	 src-table="public.curso"
	 dst-table="public.trab"
	 src-required="false" dst-required="false"/>

<relationship name="insc_has_many_seg" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#139081"
	 src-table="public.insc"
	 dst-table="public.seg"
	 src-required="true" dst-required="false"
	upd-action="CASCADE"
	del-action="RESTRICT"/>

<constraint name="nivel_id_plan_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.plan" table="public.nivel">
	<columns names="id_plan" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="grado_id_nivel_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.nivel" table="public.grado">
	<columns names="id_nivel" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="materia_id_grado_fkey" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.grado" table="public.mat">
	<columns names="id_grado" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="alum_fk" type="fk-constr" comparison-type="MATCH FULL"
	 upd-action="CASCADE" del-action="SET NULL" ref-table="public.alum" table="public.insc">
	<columns names="id_alum" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="curso_fk" type="fk-constr" comparison-type="MATCH FULL"
	 upd-action="CASCADE" del-action="SET NULL" ref-table="public.curso" table="public.insc">
	<columns names="id_curso" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="grado_fk" type="fk-constr" comparison-type="MATCH FULL"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.grado" table="public.curso">
	<columns names="id_grado" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<relationship name="rel_nivel_plan" type="relfk" layer="0"
	 src-table="public.nivel"
	 dst-table="public.plan" reference-fk="nivel_id_plan_fkey"
	 src-required="false" dst-required="false"/>

<relationship name="rel_grado_nivel" type="relfk" layer="0"
	 src-table="public.grado"
	 dst-table="public.nivel" reference-fk="grado_id_nivel_fkey"
	 src-required="false" dst-required="false"/>

<relationship name="rel_mat_grado" type="relfk" layer="0"
	 src-table="public.mat"
	 dst-table="public.grado" reference-fk="materia_id_grado_fkey"
	 src-required="false" dst-required="false"/>

<relationship name="rel_insc_alum" type="relfk" layer="0"
	 src-table="public.insc"
	 dst-table="public.alum" reference-fk="alum_fk"
	 src-required="false" dst-required="false"/>

<relationship name="rel_insc_curso" type="relfk" layer="0"
	 src-table="public.insc"
	 dst-table="public.curso" reference-fk="curso_fk"
	 src-required="false" dst-required="false"/>

<relationship name="rel_curso_grado" type="relfk" layer="0"
	 src-table="public.curso"
	 dst-table="public.grado" reference-fk="grado_fk"
	 src-required="false" dst-required="false"/>

</dbmodel>
