	<role name="uaded"/>
</sequence>

<table name="insc" layer="0" collapse-mode="2" max-obj-count="4">
	<schema name="public"/>
	<role name="uaded"/>
	<position x="740" y="340"/>
	<column name="id" not-null="true"
	 identity-type="BY DEFAULT" start="1" increment="1" min-value="1" max-value="2147483647" cache="1">
		<type name="integer" length="0"/>
	</column>
	<column name="id_alum">
		<type name="integer" length="0"/>
	</column>
	<column name="id_curso">
		<type name="integer" length="0"/>
	</column>
	<constraint name="inscripcion_pk" type="pk-constr" table="public.insc">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="inscripcion_uq" type="uq-constr" table="public.insc">
