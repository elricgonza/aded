select a.id as asi_id, 
		b.id as pro_id, b.nombre, b.paterno, b.materno, b.usr_id_login,
		c.id as cur_id, c.curso, c.paralelo,
		d.id as mat_id, d.materia, d.gra_id
	from asignado a, 
		profesor b,
		curso c,
